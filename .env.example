# ============================================================
# Site URL (canonical, OG, sitemap, JSON-LD, robots, llms.txt)
# ============================================================
# Production: set in Vercel e.g. https://studio-site-one-hazel.vercel.app
# If empty, falls back to VERCEL_PROJECT_PRODUCTION_URL then VERCEL_URL
NEXT_PUBLIC_SITE_URL=""

# ============================================================
# Auth
# ============================================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Local dev: http://localhost:3000 — Production (Vercel): your live URL
# After `vercel env pull`, change this line back to localhost for local admin login.
NEXTAUTH_URL="http://localhost:3000"

ADMIN_EMAIL=""
# Production: bcrypt hash only ($2...). Dev: plain text OK.
# Generate: npm run admin:hash-password -- 'your-strong-password'
ADMIN_PASSWORD=""

# ============================================================
# Email — Resend
# ============================================================
RESEND_API_KEY=""
# Must be a domain you verified in Resend dashboard
RESEND_FROM="סטודיו קדרות <noreply@your-domain.com>"

# ============================================================
# WhatsApp
# ============================================================
# Digits only (Israel mobile 052… → 97252…), e.g. 972525771221
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# ============================================================
# Vercel Postgres (auto-provided when you add a Postgres store)
# ============================================================
POSTGRES_URL=""
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# ============================================================
# Seed (local only — blocked in production unless explicitly set)
# ============================================================
# ALLOW_DB_SEED="true"

# ============================================================
# Vercel Blob (image uploads in production)
# ============================================================
BLOB_READ_WRITE_TOKEN=""
